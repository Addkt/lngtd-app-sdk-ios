        "dynamicFloorsEnabled": true,
        "dynamicFloorParameters": {},
        "floors": {
          "ios_US_{DC}_app_A": 2.5,
          "ios_US": 1,
          "US": 0.5,
          "default": 0.25
        },
        "includeHighestBid": false
      },
      "expected": 2.5,
      "expectedJSType": "number"
    },
